# --- Public (baked into the browser bundle at build time) ---------------------
NEXT_PUBLIC_CATALOG_API_URL=http://localhost:8001
NEXT_PUBLIC_CHECKOUT_API_URL=http://localhost:8002

# --- Server-only (never exposed to the browser) -------------------------------
# Where the SQLite file holding per-merchant provider configs lives.
PROVIDER_CONFIG_DB_PATH=./data/merchant.db

# Encrypts stored provider API keys (AES-256-GCM). REQUIRED in production;
# without it, development falls back to a well-known insecure key.
# Generate one with: openssl rand -base64 32
PROVIDER_CONFIG_ENCRYPTION_KEY=

# OpenAI integration. Merchants supply their own key through /settings — it is
# stored encrypted and read server-side only, so no key belongs in this file.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000

# Placeholder tenant until merchant authentication exists.
DEFAULT_MERCHANT_ID=merchant-local
